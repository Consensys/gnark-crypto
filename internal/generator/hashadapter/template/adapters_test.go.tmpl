import (
	"testing"

	"github.com/stretchr/testify/require"

	fr "{{.BaseFieldPackagePath}}"
	"{{.BaseFieldPackagePath}}/poseidon2"
	"{{.FieldPackagePath}}"
	"github.com/consensys/gnark-crypto/internal/hashtesting"
)
{{range .Adapters}}
// TestChallengeHasher{{.ExtensionName}} checks that the adapter writes the coordinates of the elements in the order of AppendBase, forwards PadBlock, and takes its digest from the first {{.ExtensionDegree}} elements of the base digest.
func TestChallengeHasher{{.ExtensionName}}(t *testing.T) {
	const D = {{.ExtensionDegree}}

	es := make([]{{.ElementType}}, 5)
	var coords []fr.Element
	for i := range es {
		es[i].MustSetRandom()
		coords = es[i].AppendBase(coords)
	}

	ref := poseidon2.NewMerkleDamgardFieldHasher()
	ref.WriteElements(coords[:2*D]...)
	ref.PadBlock()
	ref.WriteElements(coords[2*D:]...)
	var want {{.ElementType}}
	d := ref.SumElement()
	want.SetBase(d[:D])

	h := NewChallengeHasher{{.ExtensionName}}(poseidon2.NewMerkleDamgardFieldHasher())
	h.WriteElements(es[:2]...)
	h.PadBlock()
	h.WriteElements(es[2:]...)
	got := h.SumElement()
	require.True(t, got.Equal(&want))

	require.Equal(t, {{if eq .ExtensionDegree 6}}4{{else if eq .ExtensionDegree 3}}8{{end}}, h.BlockLen())

	hashtesting.CheckNoAllocs[{{.ElementType}}, {{.ElementType}}](t, h, es[0])
}
{{end}}

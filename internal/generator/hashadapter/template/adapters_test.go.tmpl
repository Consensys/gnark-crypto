import (
	"testing"

	"github.com/stretchr/testify/require"

	fr "{{.BaseFieldPackagePath}}"
	"{{.FieldPackagePath}}"
)

// recorder is a base hasher that records what is written to it, and returns a
// given digest.
type recorder struct {
	writes   [][]fr.Element
	digest   []fr.Element
	blockLen int
}

func (r *recorder) WriteField(e ...fr.Element) {
	r.writes = append(r.writes, append([]fr.Element(nil), e...))
}

func (r *recorder) SumSmallField() []fr.Element {
	return r.digest
}

func (r *recorder) BlockLen() int {
	return r.blockLen
}

func marshalBase(e []fr.Element) []byte {
	var b []byte
	for i := range e {
		b = append(b, e[i].Marshal()...)
	}
	return b
}

func newDigest(n int) []fr.Element {
	d := make([]fr.Element, n)
	for i := range d {
		d[i].SetUint64(uint64(100 + i))
	}
	return d
}
{{range .Adapters}}
// TestBaseFieldHashAdapter{{.ExtensionName}} checks that the adapter writes the coordinates of the
// elements to the base hasher in blocks, in the order of Marshal, whatever the split
// among the calls, and that SumField returns the first coordinates of the digest.
func TestBaseFieldHashAdapter{{.ExtensionName}}(t *testing.T) {
	for _, blockLen := range []int{1, 3, 4, 8} {
		for n := range 10 {
			es := make([]{{.ElementType}}, n)
			var want []byte
			for i := range es {
				es[i].MustSetRandom()
				want = append(want, es[i].Marshal()...)
			}

			for split := range n + 1 {
				r := &recorder{digest: newDigest(16), blockLen: blockLen}
				h := NewBaseFieldHashAdapter{{.ExtensionName}}(r)
				h.WriteField(es[:split]...)
				h.WriteField(es[split:]...)
				sum := h.SumField()

				var got []byte
				for i, w := range r.writes {
					require.LessOrEqual(t, len(w), blockLen)
					if i != len(r.writes)-1 {
						require.Len(t, w, blockLen, "a write before the last one must be a full block")
					}
					got = append(got, marshalBase(w)...)
				}
				require.Equal(t, want, got, "block length %d, %d elements split at %d", blockLen, n, split)

				require.Equal(t, marshalBase(r.digest[:{{.ExtensionDegree}}]), sum.Marshal())
			}
		}
	}

	// the digest is short, but has spare capacity: reslicing it would not panic
	short := newDigest({{.ExtensionDegree}} + 3)[:{{.ExtensionDegree}}-1]
	h := NewBaseFieldHashAdapter{{.ExtensionName}}(&recorder{digest: short, blockLen: 8})
	require.Panics(t, func() { h.SumField() }, "a digest with fewer than {{.ExtensionDegree}} elements")
}

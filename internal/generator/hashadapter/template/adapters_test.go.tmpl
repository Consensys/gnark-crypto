import (
	"testing"

	"github.com/stretchr/testify/require"

	fr "{{.BaseFieldPackagePath}}"
	"{{.BaseFieldPackagePath}}/poseidon2"
	"{{.FieldPackagePath}}"
)

// shortDigest is a hasher whose digest has the given number of elements.
type shortDigest int

func (shortDigest) WriteField(...fr.Element) {}
func (shortDigest) PadBlock()                {}
func (s shortDigest) SumField() []fr.Element { return make([]fr.Element, s) }
{{range .Adapters}}
// TestBaseFieldHashAdapter{{.ExtensionName}} checks that the adapter writes the coordinates of the elements in the order of AppendBase, forwards PadBlock, takes its digest from the first {{.ExtensionDegree}} elements of the base digest, and rejects a base hasher with a shorter digest.
func TestBaseFieldHashAdapter{{.ExtensionName}}(t *testing.T) {
	const D = {{.ExtensionDegree}}

	es := make([]{{.ElementType}}, 5)
	var coords []fr.Element
	for i := range es {
		es[i].MustSetRandom()
		coords = es[i].AppendBase(coords)
	}

	ref := poseidon2.NewMerkleDamgardHasher()
	ref.WriteField(coords[:2*D]...)
	ref.PadBlock()
	ref.WriteField(coords[2*D:]...)
	var want {{.ElementType}}
	want.SetBase(ref.SumField()[:D])

	h := NewBaseFieldHashAdapter{{.ExtensionName}}(poseidon2.NewMerkleDamgardHasher())
	h.WriteField(es[:2]...)
	h.PadBlock()
	h.WriteField(es[2:]...)
	got := h.SumField()
	require.True(t, got.Equal(&want))

	require.Panics(t, func() { NewBaseFieldHashAdapter{{.ExtensionName}}(shortDigest(D - 1)) })
}
{{end}}

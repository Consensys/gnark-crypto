func TestMulMulInternalInPlaceWidth{{- $w0}}(t *testing.T) {
	var input, expected [{{- $w0}}]fr.Element
	for i := range input {
		input[i].MustSetRandom()
	}

	expected = input

	h := NewPermutation({{- $w0}}, {{- .ParamsCompression.FullRounds}}, {{- .ParamsCompression.PartialRounds}})
	h.matMulInternalInPlace(expected[:]) 


	var sum fr.Element
	sum.Set(&input[0])
	for i := 1; i < h.params.Width; i++ {
		sum.Add(&sum, &input[i])
	}
	for i := range h.params.Width {
		input[i].Mul(&input[i], &diag{{- $w0}}[i]).
			Add(&input[i], &sum)
		if !input[i].Equal(&expected[i]) {
			t.Fatal("mat mul internal w/ diagonal doesn't match hand calculated")
		}
	}
}


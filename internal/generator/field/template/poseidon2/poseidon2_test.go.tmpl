func (h *Permutation) disableAVX512() {
	{{- $wc := .ParamsCompression.Width}}
	{{- $fc := .ParamsCompression.FullRounds}}
	{{- $pc := .ParamsCompression.PartialRounds}}
	{{- $ws := .ParamsSponge.Width}}
	{{- $fs := .ParamsSponge.FullRounds}}
	{{- $ps := .ParamsSponge.PartialRounds}}
	h.params.hasFast{{- $wc}}_{{- $fc}}_{{- $pc}} = false
	h.params.hasFast{{- $ws}}_{{- $fs}}_{{- $ps}} = false
}

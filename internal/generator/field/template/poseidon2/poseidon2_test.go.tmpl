func BenchmarkPermutation16x24(b *testing.B) {
	input := make([][16]fr.Element, 24)
	for i := range input {
		for j := range input[i] {
			input[i][j].MustSetRandom()
		}
	}
	h := NewPermutation({{- $w1}}, {{- .ParamsSponge.FullRounds}}, {{- .ParamsSponge.PartialRounds}})

	b.ResetTimer()
	for range b.N {

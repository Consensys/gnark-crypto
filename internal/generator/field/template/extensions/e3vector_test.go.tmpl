import (
	"testing"

	fr "{{ .FieldPackagePath }}"
)

// TestMulAccByElementBatchedMatchesGeneric verifies the batched tiling
// implementation independently of cpu.SupportAVX512IFMA, since on hardware
// without AVX-512IFMA (e.g. arm64), MulAccByElement's dispatch never
// exercises mulAccByElementBatched.
func TestMulAccByElementBatchedMatchesGeneric(t *testing.T) {
	for _, n := range []int{1, 7, 8, 64, 65, 100, 1000} {
		dst := make(VectorE3, n)
		scale := make([]fr.Element, n)
		for i := range n {
			dst[i].MustSetRandom()
			scale[i].MustSetRandom()
		}
		var alpha E3
		alpha.MustSetRandom()

		expected := make(VectorE3, n)
		copy(expected, dst)
		mulAccByElementGeneric(expected, scale, &alpha)

		got := make(VectorE3, n)
		copy(got, dst)
		mulAccByElementBatched(got, scale, &alpha)

		for i := range n {
			if !got[i].Equal(&expected[i]) {
				t.Fatalf("n=%d: mulAccByElementBatched[%d] mismatch with generic", n, i)
			}
		}
	}
}

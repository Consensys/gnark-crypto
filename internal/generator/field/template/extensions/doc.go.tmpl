package extensions
{{- else}}
// Package extensions implements the fields arithmetic of the 𝔽r² {{- if ne .FF "goldilocks"}} and 𝔽r⁴ {{- end}}
// extensions of the {{ .FF }} field.
//
{{- if eq .FF "babybear"}}
// - For extension 4:
//		𝔽r²[u] = 𝔽r/u²-11
